# Copy to .env and fill in

# LLM — Sarvam-30B model name on HuggingFace (confirm exact name)
LLM_MODEL=sarvamai/sarvam-m

# vLLM server running on the same GPU instance
VLLM_BASE_URL=http://localhost:8001/v1

# TTS backend: "voxtral" (self-hosted) or "voxtral_api" (Mistral cloud)
TTS_BACKEND=voxtral
# Only needed if TTS_BACKEND=voxtral_api
MISTRAL_API_KEY=

# Bind address — set 0.0.0.0 on JarvisLabs to expose publicly
HOST=0.0.0.0
PORT=8000
