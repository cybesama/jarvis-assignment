FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    python3.11 python3-pip python3.11-dev \
    libsndfile1 ffmpeg git curl \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf python3.11 /usr/bin/python3 && ln -sf python3.11 /usr/bin/python

WORKDIR /app

# Install Python deps (minus vllm — that's the llm container)
COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi uvicorn[standard] websockets python-multipart \
    pydantic pydantic-settings python-dotenv loguru aiofiles httpx \
    "nemo_toolkit[asr]" \
    mistral-inference mistralai soundfile \
    silero-vad \
    chromadb FlagEmbedding langchain langchain-community \
    beautifulsoup4 lxml numpy librosa rich typer

COPY . .

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
