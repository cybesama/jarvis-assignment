# !data/raw/
# data/chroma/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ── Virtual envs ──────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model cache (HuggingFace downloads) ───────────────────────────────────────
*.safetensors
*.bin
*.pt
*.ckpt
models/
hf_cache/

# ── Audio artifacts ───────────────────────────────────────────────────────────
*.wav
*.mp3
*.ogg
*.flac
